{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "minimumReleaseAge": "7 days",
  "extends": [
    ":disableMajorUpdates",
    "helpers:pinGitHubActionDigests",
    "helpers:disableTypesNodeMajor",
    "github>konflux-ci/mintmaker-presets:cve-automerge-high"
  ],
  "dockerfile": {
    "managerFilePatterns": [
      "/deploy/hp-eng.backend.Dockerfile/",
      "/deploy/hp-eng.frontend.Dockerfile/"
    ]
  },
  "packageRules": [
    {
      "description": "Group non-major npm development dependencies",
      "matchManagers": [ "npm" ],
      "matchDepTypes": [ "devDependencies" ],
      "matchUpdateTypes": [ "minor", "patch" ],
      "groupName": "npm development dependencies"
    },
    {
      "description": "Group non-major npm production dependencies",
      "matchManagers": [ "npm" ],
      "matchDepTypes": [ "dependencies", "optionalDependencies" ],
      "matchUpdateTypes": [ "minor", "patch" ],
      "groupName": "npm production dependencies"
    },
    {
      "description": "Group container image updates",
      "matchManagers": [ "dockerfile" ],
      "matchUpdateTypes": [ "digest", "minor", "patch", "pinDigest" ],
      "groupName": "container images"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [ "github-actions" ],
      "matchUpdateTypes": [ "digest", "minor", "patch", "pinDigest" ],
      "groupName": "GitHub Actions"
    }
  ]
}
