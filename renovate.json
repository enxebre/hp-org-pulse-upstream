{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "minimumReleaseAge": "2 days",
  "extends": [
    ":disableMajorUpdates",
    "helpers:pinGitHubActionDigests",
    "helpers:disableTypesNodeMajor",
    "github>konflux-ci/mintmaker-presets:cve-automerge-all"
  ],
  "dockerfile": {
    "managerFilePatterns": [
      "/deploy/hp-eng.backend.Dockerfile/",
      "/deploy/hp-eng.frontend.Dockerfile/"
    ]
  },
  "packageRules": [
    {
      "description": "Group npm dependencies minor, patch and digest updates",
      "matchManagers": [ "npm" ],
      "matchUpdateTypes": [ "digest", "minor", "patch" ],
      "groupName": "npm dependencies",
      "groupSlug": "npm-dependencies"
    },
    {
      "description": "Group org-pulse core package/images together",
      "matchPackageNames": [
        "@org-pulse/core",
        "quay.io/org-pulse/**"
      ],
      "groupName": "Org-Pulse Core",
      "groupSlug": "org-pulse-core"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [ "github-actions" ],
      "matchUpdateTypes": [ "digest", "minor", "patch", "pinDigest" ],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    }
  ]
}
