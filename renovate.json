{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "minimumReleaseAge": "2 days",
  "extends": [
    ":disableMajorUpdates",
    "helpers:pinGitHubActionDigests",
    "helpers:disableTypesNodeMajor",
    "github>konflux-ci/mintmaker-presets:cve-automerge-all"
  ],
  "constraints": {
    "node": "24",
    "npm": "11"
  },
  "dockerfile": {
    "managerFilePatterns": [
      "/deploy/hp-eng.backend.Dockerfile/",
      "/deploy/hp-eng.frontend.Dockerfile/",
      "/deploy/hp-eng.exporter.Dockerfile/"
    ]
  },
  "asdf": {
    "description": "Disable tools-versions updates",
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Keep Python version pinned to minor",
      "matchPackageNames": [ "registry.access.redhat.com/hi/python" ],
      "matchUpdateTypes": [ "major", "minor" ],
      "enabled": false
    },
    {
      "description": "Group Docker dependencies minor, patch and digest updates",
      "matchManagers": [ "docker" ],
      "matchUpdateTypes": [ "minor", "patch" ],
      "groupName": "docker dependencies",
      "groupSlug": "docker-dependencies"
    },
    {
      "description": "Group npm dependencies minor, patch and digest updates",
      "matchManagers": [ "npm" ],
      "matchUpdateTypes": [ "digest", "minor", "patch" ],
      "groupName": "npm dependencies",
      "groupSlug": "npm-dependencies"
    },
    {
      "description": "Group python dependencies minor, patch and digest updates",
      "matchManagers": [ "python" ],
      "matchUpdateTypes": [ "digest", "minor", "patch" ],
      "groupName": "python dependencies",
      "groupSlug": "python-dependencies"
    },
    {
      "description": "Group org-pulse core package/images together",
      "matchPackageNames": [
        "@org-pulse/core",
        "quay.io/org-pulse/**"
      ],
      "groupName": "Org-Pulse Core",
      "groupSlug": "org-pulse-core"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [ "github-actions" ],
      "matchUpdateTypes": [ "digest", "minor", "patch", "pinDigest" ],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    }
  ]
}
