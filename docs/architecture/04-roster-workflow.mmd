flowchart TB
    subgraph Cyborg["CYBORG MODE · Complete roster snapshot"]
        GCS["Cyborg data in Google Cloud Storage"] --> Python["Standalone Python exporter<br/>orgdatacore client"]
        Python --> Snapshot["Complete-roster<br/>JSON"]
        Snapshot -.-> Publish["External publication step<br/>Outside this repository"]
        Publish -.-> Saved[("Snapshot in app storage")]
        Saved --> Check["Core validation<br/>Schema · scope · freshness"]
    end

    subgraph Traditional["TRADITIONAL MODE · LDAP and enrichment"]
        LDAP["IPA LDAP<br/>People and org hierarchy"]
        Sheets["Google Sheets<br/>Team assignments and enrichment"]
    end

    Check --> Sync["Core roster sync"]
    LDAP --> Sync
    Sheets --> Sync
    Sync --> People[("People registry · team assignments")]
    People --> Dashboard["People & Teams views"]

